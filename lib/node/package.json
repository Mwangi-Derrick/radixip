{
  "name": "radixip",
  "version": "0.1.0",
  "description": "High-performance IP subnet longest-prefix match engine (Rust-backed native addon)",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "radixip.node",
    "prebuilt/**"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node tests/test.js",
    "bench": "node benchmarks/bench.js"
  },
  "napi": {
    "binaryName": "radixip",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "keywords": [
    "radix",
    "ip",
    "subnet",
    "networking",
    "napi",
    "native"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mwangi-Derrick/radixip.git"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  }
}
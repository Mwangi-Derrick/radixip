{
  "name": "radixip",
  "version": "0.1.0",
  "description": "High-performance IP subnet longest-prefix match engine (Rust-backed native addon)",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "radixip.node",
    "prebuilt/**"
  ],
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi build --platform --release",
    "test": "node tests/test.js",
    "bench": "node benchmarks/bench.js"
  },
  "napi": {
    "name": "radixip",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "x86_64-unknown-linux-musl"
      ]
    }
  },
  "keywords": [
    "radix",
    "ip",
    "subnet",
    "networking",
    "napi",
    "native"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mwangi-Derrick/radixip"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  }
}

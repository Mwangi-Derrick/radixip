# Build stage for Go gRPC server
FROM golang:1.26.1-alpine AS builder

WORKDIR /app

# Copy go.work and source directories
COPY go.work* ./
COPY lib/go ./lib/go
COPY proto ./proto
COPY cmd/grpc-server-go ./cmd/grpc-server-go

WORKDIR /app/cmd/grpc-server-go

# Download dependencies and tidy module sum entries
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/grpc-server-go .

# Final minimal runtime image
FROM alpine:3.19

# Install ca-certificates for TLS / outbound HTTP if needed
RUN apk --no-cache add ca-certificates

WORKDIR /app
COPY --from=builder /app/grpc-server-go /app/grpc-server-go

# Environment variables for configuration
ENV GRPC_PORT=50051 \
    METRICS_PORT=9090 \
    RADIXIP_CONFIG=/etc/radixip/radixip.yaml

EXPOSE 50051 9090

CMD ["/app/grpc-server-go"]

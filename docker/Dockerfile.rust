# Build stage
FROM rust:1.80-slim AS builder

WORKDIR /usr/src/app

# We only need the rust library
COPY Cargo.toml Cargo.lock ./
COPY lib/rust lib/rust

# Build a release version of the radixip-rs lib to ensure it compiles correctly
# In a real microservice, we would build the `cmd/server` or a specific binary.
# Since we don't have a standalone bin yet, we will just build the tests/examples.
WORKDIR /usr/src/app/lib/rust
RUN cargo build --release --all-targets

# We can just leave this as a builder validation for now.
# Real deployments would pull a binary out of `target/release`.

# Run stage
FROM debian:bookworm-slim
WORKDIR /root/
# COPY --from=builder /usr/src/app/target/release/radixip-server .
# CMD ["./radixip-server"]
CMD ["echo", "Rust Engine Container - Ready for binary"]

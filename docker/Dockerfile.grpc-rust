# Build stage for Rust gRPC server
FROM rust:1.97.1-alpine AS builder

RUN apk add --no-cache protobuf-dev musl-dev gcc

WORKDIR /app

# Copy workspace manifest (and lockfile if it exists)
COPY Cargo.toml Cargo.lock* ./
COPY lib/rust ./lib/rust
COPY proto ./proto
COPY cmd/grpc-server-rust ./cmd/grpc-server-rust

RUN cargo build --release -p radixip-grpc-server

# Final runtime image
FROM alpine:3.19

RUN apk --no-cache add ca-certificates libgcc

WORKDIR /app
COPY --from=builder /app/target/release/radixip-grpc-server /app/radixip-grpc-server

# Environment variables for configuration
ENV GRPC_PORT=50052 \
    METRICS_PORT=9091 \
    RADIXIP_CONFIG=/etc/radixip/radixip.yaml

EXPOSE 50052 9091

CMD ["/app/radixip-grpc-server"]
